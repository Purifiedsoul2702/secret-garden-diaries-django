[Unit]
Description=Secret Garden Diaries Django
After=network.target
[Service]
User=secretgarden
Group=www-data
WorkingDirectory=/srv/secret-garden-diaries
EnvironmentFile=/srv/secret-garden-diaries/.env
ExecStart=/srv/secret-garden-diaries/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 2 --timeout 30 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0027
[Install]
WantedBy=multi-user.target
