# PRODUCTION TEMPLATE. Copy to .env and replace EVERY placeholder.
# For local development, use python scripts/setup_local.py instead.
DEBUG=false
SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=yourdomain.in,www.yourdomain.in
CSRF_TRUSTED_ORIGINS=https://yourdomain.in,https://www.yourdomain.in
SITE_URL=https://yourdomain.in
# Only true behind your own reverse proxy that replaces forwarded headers.
TRUST_PROXY_HTTPS=false
TRUSTED_PROXY_IPS=
# SQLite works for a small single-instance site. PostgreSQL is preferred for production.
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=secretgarden
# DB_USER=secretgarden
# DB_PASSWORD=replace-with-strong-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=require
# Free Open-Meteo endpoint: non-commercial use only. Keep false if adding ads.
WEATHER_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.in
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
